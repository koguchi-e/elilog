<% content_for :title, "管理画面ログイン | elilog" %>
<% content_for :description, "elilog管理画面へのログインページです。" %>

<section class="mx-auto max-w-md">
  <p class="text-sm font-medium tracking-wide text-stone-500">ADMIN</p>
  <h1 class="mt-3 text-3xl font-bold tracking-tight">ログイン</h1>
  <%= form_with url: admin_login_path, class: "mt-8 space-y-6" do |form| %>
    <div>
      <%= form.label :password, "管理用パスワード", class: "block text-sm font-medium" %>
      <%= form.password_field :password, required: true, autofocus: true, autocomplete: "current-password", class: "mt-2 block w-full rounded-md border-stone-300 bg-white px-3 py-2 shadow-sm focus:border-stone-500 focus:ring-stone-500" %>
    </div>
    <%= form.submit "ログイン", class: "rounded-md bg-stone-900 px-4 py-2 text-sm font-medium text-white hover:bg-stone-700" %>
  <% end %>
</section>
