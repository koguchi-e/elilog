<%= form_with model: [:admin, post], class: "mt-8 space-y-6" do |form| %>
  <% if post.errors.any? %>
    <div class="rounded-md bg-red-50 p-4 text-sm text-red-800">
      <p class="font-medium">入力内容を確認してください。</p>
      <ul class="mt-2 list-inside list-disc">
        <% post.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= form.label :title, "タイトル", class: "block text-sm font-medium" %>
    <%= form.text_field :title, required: true, class: "mt-2 block w-full rounded-md border-stone-300 bg-white px-3 py-2 shadow-sm focus:border-stone-500 focus:ring-stone-500" %>
  </div>
  <div>
    <%= form.label :published_on, "公開日", class: "block text-sm font-medium" %>
    <%= form.date_field :published_on, required: true, class: "mt-2 block rounded-md border-stone-300 bg-white px-3 py-2 shadow-sm focus:border-stone-500 focus:ring-stone-500" %>
  </div>
  <div>
    <%= form.label :body, "本文", class: "block text-sm font-medium" %>
    <%= form.text_area :body, rows: 16, required: true, class: "mt-2 block w-full rounded-md border-stone-300 bg-white px-3 py-2 shadow-sm focus:border-stone-500 focus:ring-stone-500" %>
  </div>
  <div class="flex items-center gap-5">
    <%= form.submit "保存する", class: "rounded-md bg-stone-900 px-4 py-2 text-sm font-medium text-white hover:bg-stone-700" %>
    <%= link_to "一覧へ戻る", admin_posts_path, class: "text-sm text-stone-600 underline underline-offset-4" %>
  </div>
<% end %>
